  {
    "task_id": "version_compare",
    "difficulty": "medium",
    "prompt": "Implement compare_versions(a, b). Both inputs are nonempty strings of dot-separated nonnegative integer components, with optional leading zeroes in components. Compare components numerically from left to right, treating missing trailing components as zero. Return -1 if a < b, 0 if equal, and 1 if a > b. Do not convert the entire version to a floating-point number. Inputs are valid.",
    "entry_point": "compare_versions",
    "check_no_mutation": false,
    "tests": [
      {
        "args": [
          "1.2",
          "1.10"
        ],
        "expected": -1
      },
      {
        "args": [
          "1.0.0",
          "1"
        ],
        "expected": 0
      },
      {
        "args": [
          "001.02",
          "1.2.0"
        ],
        "expected": 0
      },
      {
        "args": [
          "0.0.1",
          "0"
        ],
        "expected": 1
      },
      {
        "args": [
          "10",
          "2.99"
        ],
        "expected": 1
      },
      {
        "args": [
          "1.2.3",
          "1.2.3.4"
        ],
        "expected": -1
      },
      {
        "args": [
          "99999999999999999999",
          "99999999999999999998"
        ],
        "expected": 1
      },
      {
        "args": [
          "0",
          "000.00"
        ],
        "expected": 0
      }
    ],
    "domain": "coding"
  },
