    "task_id": "evaluate_expression",
    "domain": "coding",
    "difficulty": "hard",
    "prompt": "Implement evaluate_expression(s). s is a valid arithmetic expression containing nonnegative integer literals, the binary operators +, -, *, /, unary minus, parentheses, and spaces. Use standard precedence (* and / bind tighter than + and -; operators of equal precedence are left-associative; unary minus binds tighter than * and /). Division is integer division that truncates toward zero. No division by zero occurs. Return the integer result. Do not use eval or exec.",
    "entry_point": "evaluate_expression",
    "check_no_mutation": false,
    "tests": [
      {
        "args": [
          "1 + 2 * 3"
        ],
        "expected": 7
      },
      {
        "args": [
          "(1 + 2) * 3"
        ],
        "expected": 9
      },
      {
        "args": [
          "7 / 2"
        ],
        "expected": 3
      },
      {
        "args": [
          "-7 / 2"
        ],
        "expected": -3
      },
      {
        "args": [
          "10 - 4 - 3"
        ],
        "expected": 3
      },
      {
        "args": [
          "2 * (3 + 4) - -5"
        ],
        "expected": 19
      },
      {
        "args": [
          "  42  "
        ],
        "expected": 42
      },
      {
        "args": [
          "100 / (2 * -3) + 8 * (2 - 5)"
        ],
        "expected": -40
      }
    ]
  },
